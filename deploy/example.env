# lumen-server .env (Mac Mini M4 Pro 24GB production)
#
# Copy this file to `.env` next to the `lumen-server` binary, or to the
# current working directory the server is launched from. Variables here
# are loaded automatically (dotenvy) — but explicit `export VAR=...`
# always wins (precedence: shell > .env).

# Model path (Gemma 4 26B-A4B MoE Q3)
MODEL_ID=/Users/dev/models/gemma-4-26b-a4b-mlx-3bit

# HTTP listen port
PORT=8080

# 24 GB Mac Mini memory caps (CONSERVATIVE — sharing with Moltis gateway).
#
# Sizing notes:
#   - macOS + Spotlight + background daemons: ~6-7 GB
#   - Moltis gateway (idle): ~500 MB - 1 GB
#   - lumen-server resident weights (Gemma 4 26B-A4B Q3): ~10 GB
#   - KV cache + activation transient peak: +2-3 GB
#   - Headroom buffer: 2 GB
#
# Earlier setting (12/4/14) was too aggressive — inference peak overran
# physical memory → swap thrash → SSH freeze. These values reproduce
# without the freeze on a 24 GB M4 Pro Mac Mini.
LUMEN_WIRED_LIMIT_GB=10
LUMEN_CACHE_LIMIT_GB=2
LUMEN_MEMORY_LIMIT_GB=12

# Decode-loop perf levers (already default ON, kept explicit for clarity)
LUMEN_GEMMA4_FUSE_ROUTING_EXPERTS=1

# Speculative decoding: explicitly disabled — both negative on this workload
# (Gemma 4 MoE Q3, JSON 4-field output). See memory/gemma4_mtp_negative_on_moe.md
LUMEN_GEMMA4_MTP=0
LUMEN_GEMMA4_LOOKUP_SPEC=0
